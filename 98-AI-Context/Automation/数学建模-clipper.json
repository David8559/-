{
  "schemaVersion": "0.1.0",
  "name": "数学建模 Research Capture",
  "behavior": "create",
  "noteNameFormat": "{{title|safe_name}}",
  "path": "00-Inbox/Downloaded",
  "noteContentFormat": "# {{title}}\n\n> [!info] 来源信息\n> - **来源：** {{url}}\n> - **作者：** {{author}}\n> - **发布时间：** {{published|date:\"YYYY-MM-DD\"}}\n> - **抓取时间：** {{date|date:\"YYYY-MM-DD HH:mm:ss\"}}\n\n---\n\n{{content}}\n",
  "properties": [
    {
      "name": "type",
      "value": "web-capture",
      "type": "text"
    },
    {
      "name": "source",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "published",
      "value": "{{published|date:\"YYYY-MM-DD\"}}",
      "type": "date"
    },
    {
      "name": "captured",
      "value": "{{date|date:\"YYYY-MM-DD HH:mm:ss\"}}",
      "type": "date"
    },
    {
      "name": "category",
      "value": "00-Inbox/Downloaded",
      "type": "text"
    },
    {
      "name": "status",
      "value": "untriaged",
      "type": "text"
    },
    {
      "name": "tags",
      "value": "source/web, status/untriaged, area/数学建模",
      "type": "multitext"
    }
  ],
  "triggers": []
}
